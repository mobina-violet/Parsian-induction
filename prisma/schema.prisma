generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model ConsultationRequest {
  id          String     @id @default(cuid())
  fullName    String?
  phoneNumber String?
  email       String?
  subject     String?
  message     String?
  source      LeadSource @default(HERO_WIDGET)
  productId   String?
  product     Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)
  status      LeadStatus @default(NEW)
  notes       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

enum LeadSource {
  HEADER_BUTTON
  HERO_WIDGET
  PRODUCT_PAGE
  PROJECT_PAGE
  CONTACT_PAGE
}

enum LeadStatus {
  NEW
  CONTACTED
  IN_PROGRESS
  WON
  LOST
}

enum ProductCategory {
  MELTING_FURNACE        // کوره‌های القایی ذوب
  FORGING_FURNACE        // کوره‌های القایی فورج
  HARDENING_FURNACE      // کوره‌های القایی سخت‌کاری
  FORMING_FURNACE        // کوره‌های القایی فورمینگ
  COOLING_SYSTEM
  SERVICE_EQUIPMENT      // خدمات و تجهیزات
  SPARE_PARTS            // لوازم یدکی

}
model Product {
  id          String                @id @default(cuid())
  slug        String                @unique
  name        String
  category    ProductCategory       @default(MELTING_FURNACE)
  subCategory String?               // ← این خط رو اضافه کن
  description String?
  capacityKg  Int?
  powerKw     Int?
  frequencyHz Int?
  variants    Json?
  components  Json?
  images      String[]
  featured    Boolean               @default(false)
  order       Int                   @default(0)
  requests    ConsultationRequest[]
}

// دسته‌بندی صنعتی پروژه‌ها — برای فیلتر صفحه پروژه‌ها
enum ProjectIndustry {
  STEEL
  COPPER
  ALUMINUM
  AUTOMOTIVE
  NON_FERROUS
  PRECISION_CASTING
}

model Project {
  id          String          @id @default(cuid())
  slug        String          @unique
  title       String
  industry    ProjectIndustry @default(STEEL)
  capacityKg  Int
  image       String
  videoUrl    String?
  featured    Boolean         @default(false)
  order       Int             @default(0)
  completedAt DateTime?
}
