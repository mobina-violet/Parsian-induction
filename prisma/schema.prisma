generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model ConsultationRequest {
  id          String     @id @default(cuid())
  fullName    String?
  phoneNumber String?
  email       String?
  subject     String?
  message     String?
  source      LeadSource @default(HERO_WIDGET)
  productId   String?
  status      LeadStatus @default(NEW)
  notes       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  product     Product?   @relation(fields: [productId], references: [id])
}

model Product {
  id          String                @id @default(cuid())
  slug        String                @unique
  name        String
  category    ProductCategory       @default(MELTING_FURNACE)
  description String?
  capacityKg  Int?
  powerKw     Int?
  frequencyHz Int?
  images      String[]
  featured    Boolean               @default(false)
  order       Int                   @default(0)
  components  Json?
  variants    Json?
  subCategory String?
  requests    ConsultationRequest[]
  reviews     Review[]
}
model Review {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String?
  email     String
  rating    Int      @default(5)
  message   String
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([productId])
}

model Project {
  id          String          @id @default(cuid())
  slug        String          @unique
  title       String
  industry    ProjectIndustry @default(STEEL)
  capacityKg  Int
  image       String
  videoUrl    String?
  featured    Boolean         @default(false)
  order       Int             @default(0)
  completedAt DateTime?
}

enum LeadSource {
  HEADER_BUTTON
  HERO_WIDGET
  PRODUCT_PAGE
  PROJECT_PAGE
  CONTACT_PAGE
}

enum LeadStatus {
  NEW
  CONTACTED
  IN_PROGRESS
  WON
  LOST
}

enum ProductCategory {
  MELTING_FURNACE
  FORGING_FURNACE
  HARDENING_FURNACE
  COOLING_SYSTEM
  FREQUENCY_CONVERTER
  CRUCIBLE
  LINK
  PERIPHERAL_EQUIPMENT
  FORMING_FURNACE
  SERVICE_EQUIPMENT
  SPARE_PARTS
}

enum ProjectIndustry {
  STEEL
  COPPER
  ALUMINUM
  AUTOMOTIVE
  NON_FERROUS
  PRECISION_CASTING
}
model Article {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String
  content     String
  coverImage  String?
  published   Boolean  @default(true)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
